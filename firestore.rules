rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Existing accounts may have data in this root document from the previous app.
    // The new client migrates that data to chunked snapshots, then deletes the root data.
    // All paths still belong to the same authenticated UID; the nested collections are storage only.
    match /users/{userId} {
      allow read, write: if isSignedInOwner(userId);

      match /syncState/{stateId} {
        allow read, write: if isSignedInOwner(userId);
      }

      match /syncSnapshots/{snapshotId} {
        allow read, write: if isSignedInOwner(userId);

        match /chunks/{chunkId} {
          allow read, write: if isSignedInOwner(userId);
        }
      }
    }
  }
}
