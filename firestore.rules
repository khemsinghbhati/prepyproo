rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Each signed-in user can access only their own account and sync data.
    // The manifest is on the account root; snapshot metadata and chunks are subcollections.
    match /users/{userId} {
      allow read, write: if isSignedInOwner(userId);

      match /syncSnapshots/{snapshotId} {
        allow read, write: if isSignedInOwner(userId);
      }

      match /chunks/{chunkId} {
        allow read, write: if isSignedInOwner(userId);
      }
    }

    // Subject requests are addressed to one email; only the recipient and sender can read them.
    match /subjectShares/{shareId} {
      allow create: if request.auth != null
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientEmail is string
        && request.resource.data.recipientEmail.size() > 3
        && request.resource.data.subjectName is string
        && request.resource.data.subjectData is map
        && request.resource.data.subjectData.name is string
        && request.resource.data.status == 'pending';

      allow get, list: if request.auth != null
        && (
          resource.data.senderUid == request.auth.uid
          || resource.data.recipientEmail == request.auth.token.email
        );

      // A recipient can only accept a request; sender and subject fields stay immutable.
      allow update: if request.auth != null
        && resource.data.recipientEmail == request.auth.token.email
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);

      allow delete: if request.auth != null
        && (
          resource.data.senderUid == request.auth.uid
          || resource.data.recipientEmail == request.auth.token.email
        );
    }
  }
}
