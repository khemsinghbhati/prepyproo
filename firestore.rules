rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Keep the legacy user document accessible to its owner for compatibility.
    // New client sync metadata and payload chunks live in separate nested collections.
    match /users/{userId} {
      allow read, write: if isSignedInOwner(userId);

      match /syncState/{stateId} {
        allow read, write: if isSignedInOwner(userId);
      }

      match /syncSnapshots/{snapshotId} {
        allow read, write: if isSignedInOwner(userId);

        match /chunks/{chunkId} {
          allow read, write: if isSignedInOwner(userId);
        }
      }
    }
  }
}
